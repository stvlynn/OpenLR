diff --git a/internal/windows/openlr_startup_trace.go b/internal/windows/openlr_startup_trace.go
new file mode 100644
--- /dev/null
+++ b/internal/windows/openlr_startup_trace.go
@@ -0,0 +1,57 @@
+//go:build windows && (amd64 || arm64)
+
+package windows
+
+import (
+	"fmt"
+	"os"
+	"sync/atomic"
+	"time"
+)
+
+var (
+	openLRTraceEnabled = os.Getenv("OPENLR_DIAGNOSTICS") == "1"
+	openLRTraceStarted = time.Now()
+	openLRTraceQueue   = make(chan openLRTraceEntry, 64)
+	openLRTraceDropped atomic.Uint64
+)
+
+type openLRTraceEntry struct {
+	stage   string
+	elapsed int64
+	hr      uint32
+	detail  int
+}
+
+func init() {
+	if !openLRTraceEnabled {
+		return
+	}
+	go func() {
+		for entry := range openLRTraceQueue {
+			fmt.Fprintf(os.Stderr, "OpenLR WebView2 startup stage=%s elapsed_ms=%d hr=0x%08x detail=%d dropped=%d\n",
+				entry.stage, entry.elapsed, entry.hr, entry.detail, openLRTraceDropped.Load())
+		}
+	}()
+}
+
+// Callers use fixed stage names and numbers only. Never wait for diagnostic
+// output on the UI thread or make a COM call solely to enrich a trace.
+func openLRStartupTrace(stage string, hr uintptr, detail int) {
+	if !openLRTraceEnabled {
+		return
+	}
+	entry := openLRTraceEntry{stage, time.Since(openLRTraceStarted).Milliseconds(), uint32(hr), detail}
+	select {
+	case openLRTraceQueue <- entry:
+	default:
+		openLRTraceDropped.Add(1)
+	}
+}
+
+func openLRTraceBool(value bool) int {
+	if value {
+		return 1
+	}
+	return 0
+}
