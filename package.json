{
  "name": "openlr",
  "private": true,
  "type": "module",
  "scripts": {
    "build:codecs": "node scripts/build-codecs.mjs",
    "test": "node --test --test-concurrency=2 tests/*.test.js",
    "desktop": "node scripts/desktop.mjs dev",
    "build:desktop": "node scripts/desktop.mjs build",
    "doctor": "node scripts/desktop.mjs doctor",
    "test:native": "node scripts/native-suite.mjs",
    "format": "prettier --write web/*.js web/*.css web/index.html cli/*.mjs scripts/*.mjs tests/*.js tests/*.mjs tests/fixtures/*.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.56.1",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "@colorhythm/libraw-wasm": "1.1.1",
    "@jsquash/avif": "2.1.1",
    "@jsquash/jxl": "1.3.0",
    "@techstark/opencv-js": "5.0.0-release.1",
    "exifr": "7.1.3",
    "fflate": "0.8.3",
    "libopus-wasm": "0.4.1",
    "mediabunny": "1.65.1",
    "onnxruntime-web": "1.31.1",
    "sql.js": "1.15.2",
    "utif": "3.1.0"
  },
  "bin": {
    "openlr": "cli/openlr.mjs"
  },
  "license": "AGPL-3.0-only"
}
