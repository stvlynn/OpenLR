* text=auto eol=lf
*.wasm binary
*.onnx binary
*.crw binary
*.png binary
*.jpg binary
*.gz binary
scripts/fixtures/macos-first-seek/*.webm binary
web/vendor/lensfun/*.xml -text
web/vendor/lensfun/COPYING.CC_BY-SA_3.0 -text
web/vendor/sqlite/sql.js -text
web/vendor/sqlite/LICENSE* -text
# Retain Emscripten-generated glue exactly, including its blank-line indentation.
web/vendor/codecs/jxl/codec/enc/jxl_color_enc*.js whitespace=-blank-at-eol
web/vendor/opus/LICENSE.EMSCRIPTEN whitespace=-blank-at-eol,-blank-at-eof
# Unified patch context lines preserve their upstream indentation.
scripts/fixtures/mygo-startup/*.patch whitespace=-blank-at-eol,-space-before-tab
scripts/mediabunny/*.patch whitespace=-blank-at-eol,-space-before-tab
scripts/mygo/*.patch whitespace=-blank-at-eol,-space-before-tab
# Retain vendored upstream source and license bytes, including line endings.
vendor/** -text
# Preserve the pinned upstream README's existing trailing space.
vendor/github.com/ebitengine/purego/README.md whitespace=-blank-at-eol

