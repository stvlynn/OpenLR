{
  "name": "OpenLR",
  "slug": "openlr",
  "identifier": "app.openlr.desktop",
  "version": "0.1.0",
  "frontendDist": "web",
  "buildCommand": "node scripts/build-cli.mjs",
  "bindings": ".mygo/bindings.ts",
  "out": "build",
  "macos": {
    "minimumSystemVersion": "12.0"
  },
  "linux": {
    "comment": "Local photo editing workspace",
    "categories": [
      "Graphics",
      "Photography"
    ],
    "command": "openlr"
  },
  "fileAssociations": [
    {
      "name": "JPEG photograph",
      "ext": [
        "jpg",
        "jpeg"
      ],
      "mimeType": "image/jpeg"
    },
    {
      "name": "PNG image",
      "ext": [
        "png"
      ],
      "mimeType": "image/png"
    },
    {
      "name": "Digital negative",
      "ext": [
        "dng"
      ],
      "mimeType": "image/x-adobe-dng"
    },
    {
      "name": "TIFF image",
      "ext": [
        "tif",
        "tiff"
      ],
      "mimeType": "image/tiff"
    }
  ]
}
